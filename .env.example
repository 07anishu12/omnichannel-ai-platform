NODE_ENV=development

API_HOST=127.0.0.1
API_PORT=4000
API_LOG_LEVEL=info
API_REQUIRE_MYSQL=true
API_REQUIRE_REDIS=true
API_REQUIRE_QDRANT=true

WORKER_HOST=127.0.0.1
WORKER_PORT=4001
WORKER_ENABLE_QUEUE=false

AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_AUTH_TOKEN=local-only-change-me
AI_REQUIRE_QDRANT=false

WEB_HOST=127.0.0.1
WEB_PORT=3000
API_BASE_URL=http://127.0.0.1:4000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=omnichannel_local
MYSQL_USER=omnichannel_app
MYSQL_PASSWORD=local-app-password
MYSQL_ROOT_PASSWORD=local-root-password

REDIS_URL=redis://127.0.0.1:6380
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
